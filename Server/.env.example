# =============================================================================
# Password Protector - Environment Configuration Example
# =============================================================================
# Copy this file to .env and populate with your environment-specific values
# All sensitive values should be kept private and never committed to version control

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=5000                    # Application server port (default: 5000)

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_SERVER=localhost          # Database server hostname or IP address
DB_DATABASE=password_db      # Database name
DB_USER=dbuser               # Database username
DB_PASSWORD=                 # Database password (required)
DB_PORT=5432                 # Database port (default: 5432 for PostgreSQL)


# -----------------------------------------------------------------------------
# Authentication Configuration
# -----------------------------------------------------------------------------
# JWT Settings (JSON Web Tokens)
JWT_SECRET=                  # JWT signing secret (required, min 32 characters)
ACCESS_TOKEN_EXPIRY=15m      # Access token expiration time (15 minutes)
REFRESH_TOKEN_EXPIRY=7d      # Refresh token expiration time (7 days)
