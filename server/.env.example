# Repository secrets
AWS_ACCOUNT_ID="secret"
HOSTED_ZONE_ID="secret"
CERTIFICATE_ARN="secret"
SERVERLESS_ACCESS_KEY="secret"
# Repository variables
AWS_REGION="secret"
# Environment secrets
DOMAIN_NAME="secret"
DATABASE_URL="secret" # cloud DB endpoint (used on Lambda)
DATABASE_URL_LOCAL="secret" # bastion-forwarded endpoint (auto-used when serverless-offline detects IS_OFFLINE)
COGNITO_CLIENT_ID="secret"
COGNITO_USER_POOL_ID="secret"
COGNITO_ISSUER="secret"
# Environment variables
ENV="secret"
DATABASE_PROVIDER="secret"
# VPC (from WoltFlow pattern)
LAMBDA_SECURITY_GROUP_ID="secret"
LAMBDA_SUBNET_ID="secret"
# Encryption (server-side layer 2)
SERVER_ENCRYPTION_SECRET="secret"
