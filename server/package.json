{
  "name": "password-protector-server",
  "version": "1.0.0",
  "description": "Password Protector Serverless Backend",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "serverless offline --stage dev --param local=true",
    "dev:qa": "serverless offline --stage qa --param local=true",
    "dev:prod": "serverless offline --stage prod --param local=true",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "start": "tsc --noEmit && serverless offline --stage dev --param local=true",
    "start:qa": "tsc --noEmit && serverless offline --stage qa --param local=true",
    "start:prod": "tsc --noEmit && serverless offline --stage prod --param local=true",
    "deploy:dev": "tsc --noEmit && serverless deploy --stage dev",
    "deploy:qa": "tsc --noEmit && serverless deploy --stage qa",
    "deploy:prod": "tsc --noEmit && serverless deploy --stage prod",
    "test:local": "postman collection run \"../postman/collections/PasswordProtector API\" --environment \"../postman/environments/PasswordProtector Local.environment.yaml\" ",
    "test:qa": "postman collection run \"../postman/collections/PasswordProtector API\" --environment \"../postman/environments/PasswordProtector QA.environment.yaml\" "
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1000.0",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/client-ses": "^3.1000.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "fflate": "^0.8.3",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "mongoose": "^8.24.8",
    "pg": "^8.16.2",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "serverless-http": "^4.0.0",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "jose": ">=5.0.0",
    "qs": ">=6.14.1",
    "lodash": ">=4.17.22",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
    "glob@>=9.0.0 <14.0.2": "^14.0.2",
    "uuid@<11.1.1": "^11.1.1",
    "serverless-esbuild": {
      "@effect/platform": "^0.97.3",
      "@effect/platform-node": "^0.108.4"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/aws-lambda": "^8.10.158",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.0.3",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "postman-cli": "^1.27.0",
    "serverless-esbuild": "^1.57.0",
    "serverless-offline": "^14.4.0",
    "serverless-offline-watcher": "^1.1.0",
    "serverless-prune-plugin": "^2.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.1"
  }
}
